COMPOSE_PROJECT_NAME=mepn-safwa-growth
MEPN_NODE_KEY=safwa-growth
MEPN_NODE_ORG_NAME=Safwa SME Growth Fund
MEPN_NODE_ORG_TYPE=FINANCE_ENTITY
MEPN_SINGLE_ORG_NODE=true
MEPN_NODE_PUBLIC_WEB_URL=http://localhost:5182
MEPN_NODE_PUBLIC_API_URL=http://localhost:3009
WEB_HOST_PORT=5182
API_HOST_PORT=3009
POSTGRES_HOST_PORT=5450
REDIS_HOST_PORT=6388
MINIO_API_HOST_PORT=9090
MINIO_CONSOLE_HOST_PORT=9091
WEB_ORIGIN=http://localhost:5182
WEB_ORIGINS=http://localhost:5182,http://127.0.0.1:5182
VITE_API_BASE_URL=/api/v1
POSTGRES_DB=mepn
POSTGRES_USER=mepn
POSTGRES_PASSWORD=mepn
DATABASE_URL=postgresql://mepn:mepn@localhost:5450/mepn
REDIS_URL=redis://localhost:6388
LOCAL_PASSWORD_AUTH_ENABLED=true
DEV_AUTH_ENABLED=false
NODE_FEDERATION_SHARED_SECRET=local-demo-federation-only
NODE_ENV=development
WORKER_POLL_ENABLED=true
BLOCKCHAIN_ANCHOR_ADAPTER=mock
FABRIC_ENABLED=false
