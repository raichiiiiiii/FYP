COMPOSE_PROJECT_NAME=mepn-barakah-supplies
MEPN_NODE_KEY=barakah-supplies
MEPN_NODE_ORG_NAME=Barakah Supplies Sdn Bhd
MEPN_NODE_ORG_TYPE=BUSINESS_SUPPLIER_MUDARIB
MEPN_SINGLE_ORG_NODE=true
MEPN_NODE_PUBLIC_WEB_URL=http://localhost:5174
MEPN_NODE_PUBLIC_API_URL=http://localhost:3001
WEB_HOST_PORT=5174
API_HOST_PORT=3001
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
WEB_ORIGIN=http://localhost:5174
WEB_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=/api/v1
POSTGRES_DB=mepn
POSTGRES_USER=mepn
POSTGRES_PASSWORD=mepn
