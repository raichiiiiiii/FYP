COMPOSE_PROJECT_NAME=mepn-amanah-retail
MEPN_NODE_KEY=amanah-retail
MEPN_NODE_ORG_NAME=Amanah Retail Sdn Bhd
MEPN_NODE_ORG_TYPE=BUSINESS_BUYER_SUPPLIER
MEPN_SINGLE_ORG_NODE=true
MEPN_NODE_PUBLIC_WEB_URL=http://localhost:5173
MEPN_NODE_PUBLIC_API_URL=http://localhost:3000
WEB_HOST_PORT=5173
API_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api/v1
POSTGRES_DB=mepn
POSTGRES_USER=mepn
POSTGRES_PASSWORD=mepn
DATABASE_URL=postgresql://mepn:mepn@localhost:5432/mepn
REDIS_URL=redis://localhost:6379
LOCAL_PASSWORD_AUTH_ENABLED=true
DEV_AUTH_ENABLED=false
NODE_FEDERATION_SHARED_SECRET=local-demo-federation-only
NODE_ENV=development
WORKER_POLL_ENABLED=true
BLOCKCHAIN_ANCHOR_ADAPTER=mock
FABRIC_ENABLED=false
FABRIC_MODE=mock
