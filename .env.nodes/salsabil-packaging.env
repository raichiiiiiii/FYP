COMPOSE_PROJECT_NAME=mepn-salsabil-packaging
MEPN_NODE_KEY=salsabil-packaging
MEPN_NODE_ORG_NAME=Salsabil Packaging Sdn Bhd
MEPN_NODE_ORG_TYPE=BUSINESS_SUPPLIER
MEPN_SINGLE_ORG_NODE=true
MEPN_NODE_PUBLIC_WEB_URL=http://localhost:5177
MEPN_NODE_PUBLIC_API_URL=http://localhost:3004
WEB_HOST_PORT=5177
API_HOST_PORT=3004
POSTGRES_HOST_PORT=5445
REDIS_HOST_PORT=6383
MINIO_API_HOST_PORT=9040
MINIO_CONSOLE_HOST_PORT=9041
WEB_ORIGIN=http://localhost:5177
WEB_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
VITE_API_BASE_URL=/api/v1
POSTGRES_DB=mepn
POSTGRES_USER=mepn
POSTGRES_PASSWORD=mepn
DATABASE_URL=postgresql://mepn:mepn@localhost:5445/mepn
REDIS_URL=redis://localhost:6383
LOCAL_PASSWORD_AUTH_ENABLED=true
DEV_AUTH_ENABLED=false
NODE_FEDERATION_SHARED_SECRET=local-demo-federation-only
NODE_ENV=development
WORKER_POLL_ENABLED=true
BLOCKCHAIN_ANCHOR_ADAPTER=mock
FABRIC_ENABLED=false
FABRIC_MODE=mock
