COMPOSE_PROJECT_NAME=mepn-ihsan-foods
MEPN_NODE_KEY=ihsan-foods
MEPN_NODE_ORG_NAME=Ihsan Foods Manufacturing Sdn Bhd
MEPN_NODE_ORG_TYPE=BUSINESS_SUPPLIER
MEPN_SINGLE_ORG_NODE=true
MEPN_NODE_PUBLIC_WEB_URL=http://localhost:5175
MEPN_NODE_PUBLIC_API_URL=http://localhost:3002
WEB_HOST_PORT=5175
API_HOST_PORT=3002
POSTGRES_HOST_PORT=5443
REDIS_HOST_PORT=6381
MINIO_API_HOST_PORT=9020
MINIO_CONSOLE_HOST_PORT=9021
WEB_ORIGIN=http://localhost:5175
WEB_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
VITE_API_BASE_URL=/api/v1
POSTGRES_DB=mepn
POSTGRES_USER=mepn
POSTGRES_PASSWORD=mepn
DATABASE_URL=postgresql://mepn:mepn@localhost:5443/mepn
REDIS_URL=redis://localhost:6381
LOCAL_PASSWORD_AUTH_ENABLED=true
DEV_AUTH_ENABLED=false
NODE_FEDERATION_SHARED_SECRET=local-demo-federation-only
NODE_ENV=development
WORKER_POLL_ENABLED=true
BLOCKCHAIN_ANCHOR_ADAPTER=mock
FABRIC_ENABLED=false
