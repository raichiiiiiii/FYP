NODE_ENV=production

APP_URL=https://your-domain.example
API_URL=https://your-domain.example/api
WEB_ORIGIN=https://your-domain.example
API_PORT=3000
VITE_API_BASE_URL=/api/v1

POSTGRES_DB=mepn
POSTGRES_USER=mepn
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://mepn:change_me@postgres:5432/mepn

REDIS_URL=redis://redis:6379

JWT_SECRET=change_me
SESSION_SECRET=change_me

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=mepn-documents
OBJECT_STORAGE_ACCESS_KEY=change_me
OBJECT_STORAGE_SECRET_KEY=change_me

# Current API compatibility aliases. Keep these aligned with OBJECT_STORAGE_*.
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=mepn-documents
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me

BLOCKCHAIN_ANCHOR_ADAPTER=mock
FABRIC_ENABLED=false
FABRIC_MODE=mock
FABRIC_SECRET_MOUNT=./deploy/fabric
FABRIC_GATEWAY_URL=
FABRIC_MSP_ID=
FABRIC_IDENTITY=
FABRIC_CHANNEL=
FABRIC_CHAINCODE=
FABRIC_IDENTITY_CERT_PATH=/run/secrets/fabric/identity/cert.pem
FABRIC_PRIVATE_KEY_PATH=/run/secrets/fabric/identity/key.pem
FABRIC_TLS_CERT_PATH=/run/secrets/fabric/tls/ca.crt
FABRIC_PEER_ENDPOINT=
FABRIC_GATEWAY_HOST_ALIAS=
FABRIC_SUBMIT_TIMEOUT_MS=30000
FABRIC_COMMIT_TIMEOUT_MS=30000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

WORKER_POLL_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_ATTEMPTS=5

LOG_LEVEL=info
